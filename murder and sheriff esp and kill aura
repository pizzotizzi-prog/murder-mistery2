-- // MM2 ROLE DETECTION (SISTEMA MIGLIORATO)
local function GetRole(player)
    if not player then return "Innocent" end
    
    -- 1. Checke per l'arma nel Character (Metodo più veloce)
    local char = player.Character
    if char then
        if char:FindFirstChild("Knife") or char:FindFirstChild("KnifeHandle") then return "Murderer" end
        if char:FindFirstChild("Gun") or char:FindFirstChild("Revolver") then return "Sheriff" end
    end
    
    -- 2. Checke nello zaino (Backpack)
    local bp = player:FindFirstChild("Backpack")
    if bp then
        for _, tool in pairs(bp:GetChildren()) do
            if tool:IsA("Tool") then
                local name = tool.Name:lower()
                if name:find("knife") then return "Murderer" end
                if name:find("gun") or name:find("revolver") or name:find("pistol") then return "Sheriff" end
            end
        end
    end
    
    -- 3. Fallback su valori interni di MM2 (se presenti)
    local roleVal = player:FindFirstChild("Role") or player:FindFirstChild("role")
    if roleVal and roleVal:IsA("StringValue") then return roleVal.Value end

    return "Innocent"
end

-- // ESP SYSTEM (CLIENT-SIDE ONLY)
local function UpdateESP()
    for _, player in pairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        
        if player.Character then
            -- Rimuovi vecchi highlight per evitare lag e glitch visivi
            for _, old in pairs(player.Character:GetChildren()) do
                if old.Name == "FireHub_ESP" then old:Destroy() end
            end

            if not Config.ESP.Enabled then continue end

            local role = GetRole(player)
            local color = nil

            if role == "Murderer" and Config.ESP.Murderer then color = Config.ESP.Colors.Murderer
            elseif role == "Sheriff" and Config.ESP.Sheriff then color = Config.ESP.Colors.Sheriff
            elseif role == "Innocent" and Config.ESP.Innocent then color = Config.ESP.Colors.Innocent end

            if color then
                local hl = Instance.new("Highlight")
                hl.Name = "FireHub_ESP"
                hl.FillColor = color
                hl.OutlineColor = Color3.new(1,1,1)
                hl.FillTransparency = 0.4
                hl.OutlineTransparency = 0
                hl.Parent = player.Character
            end
        end
    end
end

