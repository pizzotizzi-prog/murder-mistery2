-- helper: check if player has a tool with keywords (client-side)
local function HasToolAnywhere(player, keywords)
    keywords = keywords or {}
    if player.Character then
        for _, c in pairs(player.Character:GetChildren()) do
            if c:IsA("Tool") then
                local nm = (c.Name or ""):lower()
                for _, kw in ipairs(keywords) do
                    if nm:find(kw) then return true end
                end
            end
        end
    end
    local backpack = player:FindFirstChild("Backpack")
    if backpack then
        for _, t in pairs(backpack:GetChildren()) do
            if t:IsA("Tool") then
                local nm = (t.Name or ""):lower()
                for _, kw in ipairs(keywords) do
                    if nm:find(kw) then return true end
                end
            end
        end
    end
    return false
end

-- determino ruolo locale (metodo euristico e sicuro, solo lettura)
local function GetPlayerRole(player)
    if not player then return "Innocent" end
    -- attributo, StringValue o leaderstats
    local ok, attr = pcall(function() return player:GetAttribute("Role") end)
    if ok and type(attr) == "string" and attr ~= "" then return attr end
    local sv = player:FindFirstChild("Role") or player:FindFirstChild("role")
    if sv and sv:IsA("StringValue") then return sv.Value end
    local ls = player:FindFirstChild("leaderstats")
    if ls then
        local r = ls:FindFirstChild("Role") or ls:FindFirstChild("role")
        if r and r:IsA("StringValue") then return r.Value end
    end
    if player.Character then
        local r2 = player.Character:FindFirstChild("Role") or player.Character:FindFirstChild("role")
        if r2 and r2:IsA("StringValue") then return r2.Value end
    end
    -- fallback su strumenti
    if HasToolAnywhere(player, {"knife", "blade"}) then return "Murderer" end
    if HasToolAnywhere(player, {"pistol", "revolver", "gun", "handcannon", "sheriff"}) then return "Sheriff" end
    return "Innocent"
end

-- APPLICA ESP: crea highlight client-side (local)
local function ApplyESPToPlayer(player)
    if player == LocalPlayer then return end
    local function removeOld()
        if player.Character then
            for _, c in pairs(player.Character:GetChildren()) do
                if c.Name == "FireHub_ESP" then
                    pcall(function() c:Destroy() end)
                end
            end
        end
    end

    local function create()
        if not player.Character then return end
        removeOld()
        local hl = Instance.new("Highlight")
        hl.Name = "FireHub_ESP"
        hl.Parent = player.Character
        hl.FillTransparency = 0.6
        hl.OutlineTransparency = 0.4

        local function updateColor()
            if not hl.Parent then return end
            local role = GetPlayerRole(player) or "Innocent"
            if role == "Murderer" and Config.ShowMurderer then
                hl.FillColor = Color3.fromRGB(255,0,0)
                hl.Enabled = true
            elseif role == "Sheriff" and Config.ShowSheriff then
                hl.FillColor = Color3.fromRGB(0,150,255)
                hl.Enabled = true
            elseif role == "Innocent" and Config.ShowInnocent then
                hl.FillColor = Color3.fromRGB(255,255,255)
                hl.Enabled = true
            else
                hl.Enabled = false
            end
        end

        updateColor()
        -- connetti cambiamenti locali (character add/remove, backpack changes)
        local conCharAdded = player.CharacterAdded:Connect(function() task.wait(0.2); updateColor() end)
        local conCharRemoved = player.CharacterRemoving:Connect(function() task.wait(0.1); removeOld() end)
        -- memorizza connessioni su highlight per pulizia
        hl:GetPropertyChangedSignal("Parent"):Connect(function()
            if not hl.Parent then
                pcall(function()
                    conCharAdded:Disconnect()
                    conCharRemoved:Disconnect()
                end)
            end
        end)
    end

    if Config.EspEnabled then
        if player.Character then
            create()
        end
        player.CharacterAdded:Connect(function() task.wait(0.3); create() end)
    else
        removeOld()
    end
end

-- funzione che evidenzia pistole non possedute in Workspace (client-only, safe)
local function FindAndHighlightPistols()
    local keywords = {"pistol","revolver","handcannon","gun"}
    local found = {}
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Tool") or obj:IsA("Model") then
            local name = (obj.Name or ""):lower()
            for _, kw in ipairs(keywords) do
                if name:find(kw) then
                    -- check owner (backpack or character)
                    local parent = obj.Parent
                    local owned = false
                    if parent then
                        if parent.Name == "Backpack" and parent.Parent and parent.Parent:IsA("Player") then owned = true end
                        if Players:GetPlayerFromCharacter(parent) then owned = true end
                    end
                    if not owned then table.insert(found, obj) end
                    break
                end
            end
        end
    end

    for _, obj in ipairs(found) do
        local target = nil
        if obj:IsA("Tool") then target = obj:FindFirstChild("Handle") or obj end
        if obj:IsA("Model") then target = obj:FindFirstChild("Handle") or obj.PrimaryPart or obj end
        if target then
            local old = target:FindFirstChild("FireHub_Pistol_HL")
            if old then pcall(function() old:Destroy() end) end
            local hl = Instance.new("Highlight")
            hl.Name = "FireHub_Pistol_HL"
            hl.Parent = target
            hl.FillTransparency = 0.3
            hl.OutlineTransparency = 0
            hl.FillColor = Color3.fromRGB(0,150,255)
            delay(Config.HighlightDuration, function()
                if hl and hl.Parent then pcall(function() hl:Destroy() end) end
            end)
        end
    end

    return #found
end

-- Kill Aura simulata: va a evidenziare giocatori nel range se il client "ha il coltello" (solo visuale)
local function SimulatedKillAuraStep()
    if not Config.SimulatedKillAura then return end
    -- attiva solo se local player ha un coltello (euristica)
    local hasKnife = HasToolAnywhere(LocalPlayer, {"knife","blade"})
    if not hasKnife then return end
    -- evidenzia i giocatori entro il range
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp and myHrp then
                local dist = (hrp.Position - myHrp.Position).Magnitude
                if dist <= Config.KillAuraRange then
                    -- highlight temporaneo per indicare bersaglio - client-only
                    local old = p.Character:FindFirstChild("FireHub_KA_HL")
                    if old then pcall(function() old:Destroy() end) end
                    local hl = Instance.new("Highlight")
                    hl.Name = "FireHub_KA_HL"
                    hl.Parent = p.Character
                    hl.FillTransparency = 0.4
                    hl.OutlineTransparency = 0
                    hl.FillColor = Color3.fromRGB(255,100,0)
                    delay(0.9, function() if hl and hl.Parent then pcall(function() hl:Destroy() end) end end)
                end
            end
        end
    end
end

-- Kill Murder simulato: se hai la pistola, segnala posizione del murder (client-only)
local function SimulatedKillMurderAction()
    local hasGun = HasToolAnywhere(LocalPlayer, {"pistol","revolver","gun","handcannon"})
    if not hasGun then
        return false, "Non hai una pistola (client-side) — azione simulata non eseguita."
    end
    -- trova murder
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and GetPlayerRole and GetPlayerRole(p) == "Murderer" then
            if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local pos = p.Character.HumanoidRootPart.Position
                -- creiamo un marker locale per la posizione
                local mark = Instance.new("Part")
                mark.Name = "FireHub_Murder_Marker"
                mark.Size = Vector3.new(1,1,1)
                mark.Anchored = true
                mark.CanCollide = false
                mark.Transparency = 0.4
                mark.Color = Color3.fromRGB(255,0,0)
                mark.Position = pos + Vector3.new(0,2,0)
                mark.Parent = Workspace
                delay(3, function() if mark and mark.Parent then pcall(function() mark:Destroy() end) end end)
                return true, "Murder segnalato: guarda la posizione evidenziata."
            else
                return false, "Murder trovato ma non ha Character/HRP al momento."
            end
        end
    end
    return false, "Nessun Murder trovato (client-side)."
end

