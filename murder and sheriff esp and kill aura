                local percent = math.clamp(absX / speedSlider.slider.AbsoluteSize.X, 0, 1)
                speedSlider.fill.Size = UDim2.new(percent,0,1,0)
                local newVal = math.floor(8 + percent * (100-8))
                speedSlider.valueLabel.Text = tostring(newVal)
                speedVal.Text = tostring(newVal)
            end
        end)

        flyBtn.MouseButton1Click:Connect(function()
            local on = flyBtn.Text ~= "ON"
            flyBtn.Text = on and "ON" or "OFF"
            flyBtn.BackgroundColor3 = on and Color3.fromRGB(50,200,80) or Color3.fromRGB(150,150,150)
            -- solo indicatore: potresti aggiungere effetti visuali o HUD, ma non movimenti reali
        end)
    end

    -- tab switching
    local function showPage(name)
        for k,v in pairs(pages) do v.Visible = false end
        pages[name].Visible = true
    end
    showPage("Home")
    homeTab.MouseButton1Click:Connect(function() showPage("Home") end)
    espTab.MouseButton1Click:Connect(function() showPage("ESP") end)
    utilTab.MouseButton1Click:Connect(function() showPage("Utilities") end)

    -- open/close controls
    local openButton = Instance.new("TextButton")
    openButton.Size = UDim2.new(0,120,0,36)
    openButton.Position = UDim2.new(0.02,0,0.02,0)
    openButton.Text = "Open Fire Hub"
    openButton.Font = Enum.Font.GothamBold
    openButton.TextScaled = true
    openButton.BackgroundColor3 = Color3.fromRGB(30,30,30)
    openButton.TextColor3 = Color3.fromRGB(255,255,255)
    openButton.Parent = screenGui
    local openCorner = Instance.new("UICorner"); openCorner.CornerRadius = UDim.new(0,6); openCorner.Parent = openButton
    openButton.ZIndex = 50

    openButton.MouseButton1Click:Connect(function()
        mainFrame.Visible = true
    end)
    closeBtn.MouseButton1Click:Connect(function() mainFrame.Visible = false end)

    -- make open button toggle visibility if mainFrame gets closed
    mainFrame:GetPropertyChangedSignal("Visible"):Connect(function()
        if mainFrame.Visible then openButton.Visible = false else openButton.Visible = true end
    end)
end

