-- // UTILITIES
local function GetRole(player)
    if not player then return "Innocent" end
    
    -- Check Attributes/Values
    local role = player:GetAttribute("Role") or (player:FindFirstChild("Role") and player.Role.Value)
    if role then return role end
    
    -- Heuristic Check (Tools)
    local char = player.Character
    local bp = player:FindFirstChild("Backpack")
    
    local function checkTools(container)
        if not container then return nil end
        for _, tool in pairs(container:GetChildren()) do
            if tool:IsA("Tool") then
                local name = tool.Name:lower()
                if name:find("knife") or name:find("blade") then return "Murderer" end
                if name:find("pistol") or name:find("revolver") or name:find("gun") then return "Sheriff" end
            end
        end
    end
    
    return checkTools(char) or checkTools(bp) or "Innocent"
end

-- // ESP SYSTEM
local function ApplyESP()
    for _, player in pairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        
        local function createHighlight()
            if not player.Character then return end
            
            -- Clean old ESP
            for _, old in pairs(player.Character:GetChildren()) do
                if old.Name == "FireHub_ESP" then old:Destroy() end
            end

            if not Config.ESP.Enabled then return end

            local role = GetRole(player)
            local shouldShow = false
            local color = Color3.new(1,1,1)

            if role == "Murderer" and Config.ESP.Murderer then shouldShow, color = true, Config.ESP.Colors.Murderer
            elseif role == "Sheriff" and Config.ESP.Sheriff then shouldShow, color = true, Config.ESP.Colors.Sheriff
            elseif role == "Innocent" and Config.ESP.Innocent then shouldShow, color = true, Config.ESP.Colors.Innocent end

            if shouldShow then
                local hl = Instance.new("Highlight")
                hl.Name = "FireHub_ESP"
                hl.FillColor = color
                hl.OutlineColor = Color3.new(1,1,1)
                hl.FillTransparency = 0.5
                hl.Parent = player.Character
            end
        end
        
        createHighlight()
        player.CharacterAdded:Connect(createHighlight)
    end
end

