    killMurderCorner.Parent = killMurderBtn

    -- Effetto visivo locale
    local function TemporaryHighlightPlayers(playersList, color)
        local temp = {}
        for _, p in ipairs(playersList) do
            if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local old = p.Character:FindFirstChild("Xeno_Temp_HL")
                if old then old:Destroy() end
                local hl = Instance.new("Highlight")
                hl.Name = "Xeno_Temp_HL"
                hl.Parent = p.Character
                hl.FillTransparency = 0.3
                hl.OutlineTransparency = 0
                hl.FillColor = color or Color3.new(1,0,0)
                table.insert(temp, hl)
            end
        end

        delay(Config.HighlightDuration, function()
            for _, h in ipairs(temp) do
                if h and h.Parent then pcall(function() h:Destroy() end) end
            end
        end)
    end

    -- Azioni bottoni
    killAllBtn.Activated:Connect(function()
        local others = {}
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then table.insert(others, p) end
        end
        TemporaryHighlightPlayers(others, Config.MurdererColor)
        print("Kill All requested — ACTIONS DISABLED IN THIS SAFE SCRIPT.")
    end)

    killMurderBtn.Activated:Connect(function()
        local murderers = {}
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                if GetPlayerRole(p) == "Murderer" then
                    table.insert(murderers, p)
                end
            end
        end
        TemporaryHighlightPlayers(murderers, Config.SheriffColor)
        print("Kill Murderer requested — ACTIONS DISABLED IN THIS SAFE SCRIPT.")
    end)

    print("--- UI CREATED AND VISIBLE ---")
end

